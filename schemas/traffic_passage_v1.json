{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkit.example/schemas/traffic_passage_v1.json",
  "title": "CheckIt traffic passage v1",
  "description": "Logical traffic_passages row. Parquet v1 encodes path_points as compact deterministic JSON text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sensor_id", "boot_id", "track_id", "started_at", "ended_at", "direction",
    "traffic_class", "class_confidence", "quality_status", "quality_score",
    "association_confidence", "direction_consistency", "hit_count", "duration_ms",
    "median_speed_kmh", "p85_speed_kmh", "max_speed_kmh", "mean_snr", "max_snr",
    "peak_cluster_size", "travel_distance_m", "entry_distance_m", "entry_angle_deg",
    "exit_distance_m", "exit_angle_deg", "firmware_version", "model_version",
    "path_points", "created_at", "received_at", "human_label", "label_confidence",
    "label_notes", "labeled_at"
  ],
  "properties": {
    "sensor_id": {"type": "string"},
    "boot_id": {"type": "integer"},
    "track_id": {"type": "integer"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "direction": {"type": "string"},
    "traffic_class": {"type": "string"},
    "class_confidence": {"type": "number"},
    "quality_status": {"type": "string"},
    "quality_score": {"type": "integer"},
    "association_confidence": {"type": "number"},
    "direction_consistency": {"type": "number"},
    "hit_count": {"type": "integer"},
    "duration_ms": {"type": "integer"},
    "median_speed_kmh": {"type": "integer"},
    "p85_speed_kmh": {"type": "integer"},
    "max_speed_kmh": {"type": "integer"},
    "mean_snr": {"type": "integer"},
    "max_snr": {"type": "integer"},
    "peak_cluster_size": {"type": "integer"},
    "travel_distance_m": {"type": "number"},
    "entry_distance_m": {"type": "integer"},
    "entry_angle_deg": {"type": "integer"},
    "exit_distance_m": {"type": "integer"},
    "exit_angle_deg": {"type": "integer"},
    "firmware_version": {"type": "string"},
    "model_version": {"type": "string"},
    "path_points": {"description": "JSONB logically; compact JSON text in Parquet v1", "type": ["array", "object", "string"]},
    "created_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "human_label": {"type": ["string", "null"]},
    "label_confidence": {"type": ["number", "null"]},
    "label_notes": {"type": ["string", "null"]},
    "labeled_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
